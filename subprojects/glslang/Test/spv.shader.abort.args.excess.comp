#version 450

#extension GL_EXT_abort : require

layout(local_size_x = 1) in;

layout(set = 0, binding = 0) buffer Data {
    int   i;
    uint  u;
    float f;
} data;

// More parameters than format specifiers. The spec says the excess arguments
// are ignored when the message is formatted, but they are still part of the call.
void main() {
    abortEXT("excess: %d", data.i, data.u, data.f);
}
